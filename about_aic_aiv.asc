// Host侧应用程序需要包含的头文件
#include "acl/acl.h"
// Kernel侧需要包含的头文件
#include "kernel_operator.h"


__global__ __aicore__ void hello_world()
{
    // 设置Kernel类型，控制算子执行时仅启动Vector核    
    // KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    // KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);

    auto cid = AscendC::GetBlockIdx();
    auto vid = AscendC::GetSubBlockIdx();

    if ASCEND_IS_AIC {
        AscendC::printf("=============== Running On Cube: cid = %d, vid = %d;\n", cid, vid);
    }

    if ASCEND_IS_AIV {
        cid = cid / 2;
        AscendC::printf("=============== Running On Vector: cid = %d, vid = %d;\n", cid, vid);
    }
}

int32_t main(int argc, char const *argv[])
{
    // 初始化
    aclInit(nullptr);

    // 运行管理资源申请
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    constexpr uint32_t blockDim = 24;
    // 用内核调用符<<<>>>调用核函数
    hello_world<<<blockDim, nullptr, stream>>>();
    aclrtSynchronizeStream(stream);

    // 资源释放和去初始化
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);

    aclFinalize();
    return 0;
}
